# Copy to .env and edit. scripts/init-secrets appends SECRETS_DIR.

# Qwen on the Spark: host:port that qwen-proxy forwards to (the only address lab assistants can reach)
SPARK_ADDR=100.95.29.126:8000
MODEL_NAME=nvidia/Qwen3.8-Flash-Next-FP4-Local
MODEL_CONTEXT_WINDOW=32768

# Lab-assistant job slots (8 matches the Spark's measured sweet spot)
WORKERS=8
VERIFIER_MAX_WORKERS=12

# Researcher
RESEARCHER_MODEL=claude-opus-5-5
RESEARCHER_INTERVAL_MIN=45
RESEARCHER_CAP_PCT=80

# Status page: bind to the host's Tailscale IP so only the tailnet can reach it
STATUS_BIND=127.0.0.1

# Container runtime socket for the launcher. Rootless Podman: /run/user/<uid>/podman/podman.sock
CONTAINER_SOCKET=/var/run/docker.sock

# Commit of the loop code, stamped on every event (export GIT_SHA=$(git rev-parse --short HEAD) before building)
GIT_SHA=nogit
