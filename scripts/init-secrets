#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = []
# ///
"""Create one random token per substrate role in secrets/ (once) and record SECRETS_DIR in .env.

Existing tokens are kept. The directory is private to you (0700); the files are 0644 so the containers'
unprivileged user can read the ones mounted into them. Re-run safely at any time.
"""

import json
import secrets
from pathlib import Path

REPO = Path(__file__).resolve().parents[1]
ROLES = [r for r in json.loads((REPO / "loop" / "policy.json").read_text())["roles"] if r != "substrate"]


def main() -> None:
    d = REPO / "secrets"
    d.mkdir(exist_ok=True)
    d.chmod(0o700)
    for role in ROLES:
        f = d / role
        if not f.exists():
            f.write_text(secrets.token_hex(32) + "\n")
            print(f"created secrets/{role}")
        f.chmod(0o644)
    env = REPO / ".env"
    lines = env.read_text().splitlines() if env.exists() else []
    lines = [l for l in lines if not l.startswith("SECRETS_DIR=")] + [f"SECRETS_DIR={d}"]
    env.write_text("\n".join(lines) + "\n")
    print(f"SECRETS_DIR={d} written to .env")


if __name__ == "__main__":
    main()
